# OpsMemory Production Environment Variables

# App
PROJECT_NAME="OpsMemory"
VERSION="1.0.0"
DEMO_MODE=false
ENVIRONMENT="production"
PORT=8001

# Security & Multi-Tenancy
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
ENCRYPTION_KEY="replace-with-a-valid-fernet-key"

# Database (PostgreSQL for production; SQLite for local development)
DATABASE_URL="postgresql://opsmemory:opsmemory_password@postgres:5432/opsmemory"
# DATABASE_URL="sqlite:///./opsmemory.db"

# Automation & Self-Recovery Controls
AUTOMATION_ENABLED="true"
AUTOMATION_DRY_RUN="false"
AUTOMATION_CONFIDENCE_THRESHOLD="0.95"
AUTOMATION_HEALTH_CHECK_COUNT="3"
AUTOMATION_HEALTH_CHECK_INTERVAL_SECONDS="5"

# Redis Task Queue
REDIS_URL="redis://redis:6379/0"

# Groq LLM Provider
# Get your API key at https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Hindsight Long-term Organizational Memory Layer
# Official Hindsight client credentials
HINDSIGHT_API_KEY="hind_your_hindsight_api_key_here"
HINDSIGHT_BASE_URL="https://api.hindsight.vectorize.io"
HINDSIGHT_BANK_ID="opsmemory-demo"

# GitHub Integration (GitHub App or OAuth)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_WEBHOOK_SECRET="opsmemory-github-webhook-secret"
GITHUB_TOKEN=""

# GitLab Integration
GITLAB_CLIENT_ID="your_gitlab_client_id"
GITLAB_CLIENT_SECRET="your_gitlab_client_secret"
GITLAB_URL="https://gitlab.com"
GITLAB_WEBHOOK_SECRET="opsmemory-gitlab-webhook-secret"
GITLAB_TOKEN=""
